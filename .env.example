# Server-only Places API (New) — not Business Profile. Local: copy to ignored `.env.local` and/or `.dev.vars`.
GOOGLE_PLACES_API_KEY=

# Stripe Checkout (test keys for sandbox; live keys for production)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDING_SETUP=
STRIPE_PRICE_FOUNDING_MONTHLY=
STRIPE_PRICE_MONTHLY=
# Optional: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Optional legacy hosted Payment Link override (unused when /api/checkout is configured)
REVIEWKIT_CHECKOUT_URL=

# Waitlist notifications (Gmail SMTP app password) — nothing is stored
SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
DEST_ADDRESS=
